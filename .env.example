# Justigo AI Environment Configuration
# Brand: Justigo | Tagline: Understand Your Rights. Know Your Next Step.

# Port for Express server
PORT=3000

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4

# Google AI Configuration
# Primary target model per project specification
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it
# Provide your Google Gemini / Generative Language API Key below
GEMINI_API_KEY=

# Default Active AI Provider: 'ollama' or 'google'
DEFAULT_PROVIDER=ollama
